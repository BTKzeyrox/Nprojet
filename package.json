{
  "name": "gestion-pro",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "check:clients": "npx --yes tsx scripts/check-clients.ts",
    "check:clients-server": "npx --yes tsx scripts/check-clients-server.ts",
    "check:clients-page": "esbuild scripts/check-clients-page.tsx --bundle --platform=node --format=esm --packages=external --target=node20 --define:import.meta.env={} --log-level=error --outfile=node_modules/.cache/check-clients-page.mjs && node node_modules/.cache/check-clients-page.mjs",
    "check:cash": "npx --yes tsx scripts/check-cash.ts",
    "check:company": "npx --yes tsx scripts/check-company.ts",
    "check:company-page": "esbuild scripts/check-company-page.tsx --bundle --platform=node --format=esm --packages=external --target=node20 --define:import.meta.env={} --log-level=error --outfile=node_modules/.cache/check-company-page.mjs && node node_modules/.cache/check-company-page.mjs",
    "check:finance": "npx --yes tsx scripts/check-finance.ts",
    "check:finance-stats": "npx --yes tsx scripts/check-finance-stats.ts",
    "check:stock": "esbuild scripts/check-stock.tsx --bundle --platform=node --format=esm --packages=external --target=node20 --define:import.meta.env={} --log-level=error --outfile=node_modules/.cache/check-stock.mjs && node node_modules/.cache/check-stock.mjs",
    "check:phase4": "esbuild scripts/check-phase4.tsx --bundle --platform=node --format=esm --packages=external --target=node20 --define:import.meta.env={} --log-level=error --outfile=node_modules/.cache/check-phase4.mjs && node node_modules/.cache/check-phase4.mjs",
    "check:phase2": "esbuild scripts/check-phase2.ts --bundle --platform=node --format=esm --packages=external --target=node20 --define:import.meta.env={} --log-level=error --outfile=node_modules/.cache/check-phase2.mjs && node node_modules/.cache/check-phase2.mjs",
    "check:finance-page": "esbuild scripts/check-finance-page.tsx --bundle --platform=node --format=esm --packages=external --target=node20 --define:import.meta.env={} --log-level=error --outfile=node_modules/.cache/check-finance-page.mjs && node node_modules/.cache/check-finance-page.mjs",
    "check:page": "esbuild scripts/check-stats-page.tsx --bundle --platform=node --format=esm --packages=external --target=node20 --define:import.meta.env={} --log-level=error --outfile=node_modules/.cache/check-stats-page.mjs && node node_modules/.cache/check-stats-page.mjs",
    "check:chart-scale": "npx --yes tsx scripts/check-chart-scale.ts",
    "check:charts": "npx --yes tsx scripts/check-charts.tsx",
    "check:stats": "npx --yes tsx scripts/check-stats.ts",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "tsc --noEmit",
    "check:demo-stats": "npx --yes tsx scripts/check-demo-stats.ts",
    "check:client-price": "npx --yes tsx scripts/check-client-price.ts"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  }
}
